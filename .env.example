# Development-only defaults. Replace every secret before using this stack
# outside an isolated local environment.
COMPOSE_PROJECT_NAME=mirante
HTTP_PORT=8000
MIRANTE_PORT=5173

# Runtime images. The GeoNode project publishes these tags for AMD64. ARM64
# development additionally uses compose.arm64.yml for the four compatibility
# images that GeoNode does not publish for ARM64.
GEONODE_IMAGE=geonode/geonode
GEONODE_VERSION=5.1.0
GEONODE_NGINX_IMAGE=geonode/nginx
GEONODE_NGINX_VERSION=1.31.2-latest
GEOSERVER_IMAGE=geonode/geoserver
GEOSERVER_VERSION=2.28.4-latest
POSTGIS_IMAGE=geonode/postgis
POSTGIS_VERSION=15-3.5-latest
MEMCACHED_IMAGE=memcached
MEMCACHED_VERSION=1.6-alpine
REDIS_IMAGE=redis
REDIS_VERSION=7-alpine

# API requests use the Vite same-origin proxy during local development.
# Browser navigation opens the public GeoNode web origin directly.
VITE_GEONODE_BASE_URL=/
VITE_GEONODE_WEB_URL=http://localhost:8000
# Set to true to require an authenticated GeoNode session before loading Mirante.
VITE_REQUIRE_AUTHENTICATION=false
# Set to false to hide visibility choices and preserve GeoNode's default upload permissions.
VITE_DATASET_UPLOAD_VISIBILITY_CONTROL=true

# GeoNode 5.1.0
DJANGO_SETTINGS_MODULE=geonode.settings
GEONODE_INSTANCE_NAME=Mirante GeoNode
SITEURL=http://localhost:8000/
ALLOWED_HOSTS="['django', 'localhost', '127.0.0.1']"
CSRF_TRUSTED_ORIGINS=http://localhost:8000
DEBUG=True
SECRET_KEY=local-only-change-this-django-secret-key
FORCE_REINIT=false
INVOKE_LOG_STDOUT=true
C_FORCE_ROOT=1

# Initial local administrator. These values are applied on the first startup.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=local-only-change-this-admin-password
ADMIN_EMAIL=admin@example.test
OAUTH2_CLIENT_ID=mirante-local-client
OAUTH2_CLIENT_SECRET=local-only-change-this-oauth-client-secret

# PostgreSQL and PostGIS
POSTGRES_USER=postgres
POSTGRES_PASSWORD=local-only-change-this-postgres-password
GEONODE_DATABASE=geonode
GEONODE_DATABASE_USER=geonode
GEONODE_DATABASE_PASSWORD=local-only-change-this-geonode-password
GEONODE_GEODATABASE=geonode_data
GEONODE_GEODATABASE_USER=geonode_data
GEONODE_GEODATABASE_PASSWORD=local-only-change-this-geodata-password
GEONODE_DATABASE_SCHEMA=public
GEONODE_GEODATABASE_SCHEMA=public
DATABASE_HOST=db
DATABASE_PORT=5432
DATABASE_URL=postgis://geonode:local-only-change-this-geonode-password@db:5432/geonode
GEODATABASE_URL=postgis://geonode_data:local-only-change-this-geodata-password@db:5432/geonode_data
GEONODE_DB_CONN_MAX_AGE=0
GEONODE_DB_CONN_TOUT=5
POSTGRESQL_MAX_CONNECTIONS=200

# Asynchronous processing
BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
CELERY__BEAT_SCHEDULE=celery.beat:PersistentScheduler
CELERY__BEAT_DB=/data/celerybeat-schedule
ASYNC_SIGNALS=True

# Reverse proxy
GEONODE_LB_HOST_IP=django
GEONODE_LB_PORT=8000
NGINX_BASE_URL=http://localhost:8000
HTTP_HOST=localhost
HTTPS_HOST=
HTTPS_PORT=8443
LETSENCRYPT_MODE=disabled
RESOLVER=127.0.0.11

# GeoServer 2.28.4
GEOSERVER_LB_HOST_IP=geoserver
GEOSERVER_LB_PORT=8080
GEOSERVER_LOCATION=http://geoserver:8080/geoserver/
GEOSERVER_PUBLIC_LOCATION=http://localhost:8000/geoserver/
GEOSERVER_WEB_UI_LOCATION=http://localhost:8000/geoserver/web/
GEOSERVER_ADMIN_USER=admin
GEOSERVER_ADMIN_PASSWORD=local-only-change-this-geoserver-password
GEOSERVER_CSRF_ENABLED=true
GEOSERVER_CSRF_WHITELIST=localhost
GEOSERVER_JAVA_OPTS="-Djava.awt.headless=true -Dgwc.context.suffix=gwc -Xms512m -Xmx1536m -Duser.timezone=UTC -Dfile.encoding=UTF-8 -DGEOSERVER_CSRF_DISABLED=false -DGEOSERVER_CSRF_WHITELIST=localhost"

# Local security and API behavior
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=http://localhost:8000
X_FRAME_OPTIONS=SAMEORIGIN
SESSION_ENGINE=django.contrib.sessions.backends.cached_db
SESSION_EXPIRED_CONTROL_ENABLED=True
ACCOUNT_OPEN_SIGNUP=True
ACCOUNT_EMAIL_VERIFICATION=none
API_LOCKDOWN=False
LOCKDOWN_GEONODE=False
DEFAULT_ANONYMOUS_PERMISSIONS=download
DEFAULT_REGISTERED_MEMBERS_PERMISSIONS=download

# Storage and ingestion
STATIC_ROOT=/mnt/volumes/statics/static/
MEDIA_ROOT=/mnt/volumes/statics/uploaded/
ASSETS_ROOT=/mnt/volumes/statics/assets/
DEFAULT_BACKEND_DATASTORE=datastore
DEFAULT_BACKEND_UPLOADER=geonode.importer
DEFAULT_MAX_UPLOAD_SIZE=5368709120
DEFAULT_MAX_PARALLEL_UPLOADS_PER_USER=5
MEMCACHED_ENABLED=True
MEMCACHED_LOCATION=memcached:11211
TIME_ENABLED=True
MOSAIC_ENABLED=False
HAYSTACK_SEARCH=False

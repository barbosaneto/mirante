# Copy this file to .env, keep it private, replace every placeholder value, and
# review every public-access policy before startup.
COMPOSE_PROJECT_NAME=mirante-production
DOCKER_ENV=production

# Mirante image and public edge
MIRANTE_IMAGE=ghcr.io/barbosaneto/mirante
MIRANTE_VERSION=0.1.1
MIRANTE_HTTP_PORT=8080
MIRANTE_PUBLIC_URL=https://mirantegeo.org
MIRANTE_REQUIRE_AUTHENTICATION=false
MIRANTE_DATASET_UPLOAD_VISIBILITY_CONTROL=true
MIRANTE_DATASET_UPLOAD_MAX_FILE_SIZE_BYTES=104857600
MIRANTE_PROXY_MAX_BODY_SIZE=210m

# Official runtime images used directly on AMD64. ARM64 deployments additionally
# apply compose.arm64.yml, which replaces only the four AMD64-only GeoNode images.
GEONODE_IMAGE=geonode/geonode
GEONODE_VERSION=5.1.0
GEONODE_NGINX_IMAGE=geonode/nginx
GEONODE_NGINX_VERSION=1.31.2-latest
GEOSERVER_IMAGE=geonode/geoserver
GEOSERVER_VERSION=2.28.4-latest
POSTGIS_IMAGE=geonode/postgis
POSTGIS_VERSION=15-3.5-latest
MEMCACHED_IMAGE=memcached
MEMCACHED_VERSION=1.6-alpine
REDIS_IMAGE=redis
REDIS_VERSION=7-alpine

# GeoNode application
DJANGO_SETTINGS_MODULE=geonode.settings
GEONODE_INSTANCE_NAME=Mirante GeoNode
SITEURL=https://mirantegeo.org/
ALLOWED_HOSTS="['django', 'nginx', 'mirantegeo.org']"
DEBUG=False
SECRET_KEY=replace-with-random-django-secret
FORCE_REINIT=false
INVOKE_LOG_STDOUT=true
C_FORCE_ROOT=1

# Initial account and GeoServer OAuth client. Initial account values are used
# during first initialization; changing them later does not rotate credentials.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-random-admin-password
ADMIN_EMAIL=admin@mirantegeo.org
OAUTH2_API_KEY=replace-with-random-oauth-api-key
OAUTH2_CLIENT_ID=replace-with-random-oauth-client-id
OAUTH2_CLIENT_SECRET=replace-with-random-oauth-client-secret

# PostgreSQL and PostGIS. Keep the repeated passwords synchronized in URLs.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-random-postgres-password
GEONODE_DATABASE=geonode
GEONODE_DATABASE_USER=geonode
GEONODE_DATABASE_PASSWORD=replace-with-random-geonode-db-password
GEONODE_GEODATABASE=geonode_data
GEONODE_GEODATABASE_USER=geonode_data
GEONODE_GEODATABASE_PASSWORD=replace-with-random-geodata-db-password
GEONODE_DATABASE_SCHEMA=public
GEONODE_GEODATABASE_SCHEMA=public
DATABASE_HOST=db
DATABASE_PORT=5432
DATABASE_URL=postgis://geonode:replace-with-random-geonode-db-password@db:5432/geonode
GEODATABASE_URL=postgis://geonode_data:replace-with-random-geodata-db-password@db:5432/geonode_data
GEONODE_DB_CONN_MAX_AGE=0
GEONODE_DB_CONN_TOUT=5
POSTGRESQL_MAX_CONNECTIONS=200

# Asynchronous processing
BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
CELERY_BEAT_SCHEDULER=celery.beat:PersistentScheduler
CELERY__BEAT_DB=/data/celerybeat-schedule
ASYNC_SIGNALS=True

# Internal GeoNode Nginx. Public TLS terminates at the host edge; the internal
# self-issued certificate preserves HTTPS semantics between proxy layers.
GEONODE_LB_HOST_IP=django
GEONODE_LB_PORT=8000
NGINX_BASE_URL=https://mirantegeo.org
HTTP_HOST=mirantegeo.org
HTTPS_HOST=mirantegeo.org
HTTP_PORT=80
HTTPS_PORT=443
LETSENCRYPT_MODE=disabled
RESOLVER=127.0.0.11

# GeoServer 2.28.4
GEOSERVER_LB_HOST_IP=geoserver
GEOSERVER_LB_PORT=8080
GEOSERVER_LOCATION=http://geoserver:8080/geoserver/
GEOSERVER_PUBLIC_LOCATION=https://mirantegeo.org/geoserver/
GEOSERVER_WEB_UI_LOCATION=https://mirantegeo.org/geoserver/web/
GEOSERVER_ADMIN_USER=admin
GEOSERVER_ADMIN_PASSWORD=replace-with-random-geoserver-password
GEOSERVER_CSRF_ENABLED=true
GEOSERVER_CSRF_WHITELIST=mirantegeo.org
GEOSERVER_JAVA_OPTS="-Djava.awt.headless=true -Dgwc.context.suffix=gwc -Xms512m -Xmx3g -Duser.timezone=UTC -Dfile.encoding=UTF-8 -DGEOSERVER_CSRF_DISABLED=false -DGEOSERVER_CSRF_WHITELIST=mirantegeo.org"

# Sessions, access, registration, and browser security
CORS_ALLOW_ALL_ORIGINS=False
X_FRAME_OPTIONS=SAMEORIGIN
SESSION_ENGINE=django.contrib.sessions.backends.cached_db
SESSION_EXPIRED_CONTROL_ENABLED=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
CSRF_COOKIE_HTTPONLY=False
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0
ACCOUNT_OPEN_SIGNUP=False
ACCOUNT_APPROVAL_REQUIRED=False
ACCOUNT_EMAIL_VERIFICATION=none
API_LOCKDOWN=False
LOCKDOWN_GEONODE=False
DEFAULT_ANONYMOUS_PERMISSIONS=download
DEFAULT_REGISTERED_MEMBERS_PERMISSIONS=download

# Storage, ingestion, and cache
STATIC_ROOT=/mnt/volumes/statics/static/
MEDIA_ROOT=/mnt/volumes/statics/uploaded/
ASSETS_ROOT=/mnt/volumes/statics/assets/
DEFAULT_BACKEND_DATASTORE=datastore
DEFAULT_BACKEND_UPLOADER=geonode.importer
DEFAULT_MAX_UPLOAD_SIZE=104857600
DEFAULT_MAX_PARALLEL_UPLOADS_PER_USER=5
MEMCACHED_ENABLED=True
MEMCACHED_LOCATION=memcached:11211
TIME_ENABLED=True
MOSAIC_ENABLED=False
HAYSTACK_SEARCH=False

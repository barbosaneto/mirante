# Copy to a private file outside version control and adjust for the deployment.
COMPOSE_PROJECT_NAME=mirante-production
MIRANTE_HTTP_PORT=8080

# Public release image. Pin the complete version instead of a mutable tag.
MIRANTE_IMAGE=ghcr.io/barbosaneto/mirante
MIRANTE_VERSION=0.1.1

# Private origin reachable from the Mirante container. Do not include a path.
GEONODE_INTERNAL_URL=https://geonode.example.org

# Browser requests normally use the same-origin reverse proxy.
MIRANTE_GEONODE_BASE_URL=/
# Public GeoNode origin used for its complete management interface.
MIRANTE_GEONODE_WEB_URL=https://geonode.example.org

MIRANTE_REQUIRE_AUTHENTICATION=false
MIRANTE_DATASET_UPLOAD_VISIBILITY_CONTROL=true
MIRANTE_DATASET_UPLOAD_MAX_FILE_SIZE_BYTES=104857600
# GeoNode 5.1 ZIP uploads carry the archive in two multipart fields. Keep this
# above twice the frontend file limit, with room for multipart overhead.
MIRANTE_PROXY_MAX_BODY_SIZE=210m

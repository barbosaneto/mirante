{
  "name": "mirante",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "An extensible open-source Web GIS client for GeoNode.",
  "license": "Apache-2.0",
  "packageManager": "npm@10.8.2",
  "engines": {
    "node": ">=18.18.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspace @mirante/app",
    "dev": "npm run dev --workspace @mirante/app",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test": "vitest run --config apps/mirante/vite.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "9.28.0",
    "@testing-library/jest-dom": "5.17.0",
    "@testing-library/react": "14.3.1",
    "@types/react": "18.3.23",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.3.4",
    "eslint": "9.28.0",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.19",
    "globals": "15.15.0",
    "jsdom": "22.1.0",
    "prettier": "3.5.3",
    "typescript": "5.6.3",
    "typescript-eslint": "8.30.1",
    "vite": "6.4.3",
    "vitest": "3.2.7"
  }
}
